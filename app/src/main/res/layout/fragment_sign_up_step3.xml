<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/header"
        layout="@layout/layout_screen_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DriveNext.Circle" />

                <ImageView
                    android:id="@+id/avatarAddBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/signup_avatar_hint"
                style="@style/TextAppearance.DriveNext.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_license_number"
                style="@style/TextAppearance.DriveNext.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/licenseNumberLayout"
                style="@style/Widget.DriveNext.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/licenseNumberInput"
                    style="@style/Widget.DriveNext.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_license_number"
                    android:inputType="number"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_license_date"
                style="@style/TextAppearance.DriveNext.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/issueDateLayout"
                style="@style/Widget.DriveNext.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:startIconContentDescription="@string/content_description_calendar"
                app:startIconDrawable="@drawable/ic_calendar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/issueDateInput"
                    style="@style/Widget.DriveNext.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_date"
                    android:inputType="datetime" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_license_photo"
                style="@style/TextAppearance.DriveNext.Label" />

            <LinearLayout
                android:id="@+id/licensePhotoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/licensePhotoImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/upload_photo"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_upload"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DriveNext.Rounded8"
                    app:strokeColor="@color/text_gray_700"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/licensePhotoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/upload_photo"
                    style="@style/TextAppearance.DriveNext.Subtitle" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_passport_photo"
                style="@style/TextAppearance.DriveNext.Label" />

            <LinearLayout
                android:id="@+id/passportPhotoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/passportPhotoImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/upload_photo"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_upload"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DriveNext.Rounded8"
                    app:strokeColor="@color/text_gray_700"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/passportPhotoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/upload_photo"
                    style="@style/TextAppearance.DriveNext.Subtitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/photosError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/error_photos_required"
                style="@style/TextAppearance.DriveNext.Error"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ru.mtuci.drivenext.presentation.view.LoadingButton
        android:id="@+id/nextButton"
        style="@style/Widget.DriveNext.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:enabled="false"
        android:text="@string/action_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />
</androidx.constraintlayout.widget.ConstraintLayout>

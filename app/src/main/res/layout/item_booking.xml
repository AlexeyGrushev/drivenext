<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bookingTitle"
        style="@style/TextAppearance.DriveNext.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        tools:text="Mercedes-Benz S 500 Sedan" />

    <TextView
        android:id="@+id/bookingSubtitle"
        style="@style/TextAppearance.DriveNext.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        tools:text="Начало аренды: 08:00, 27 сентября 2024" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_divider_line" />
</LinearLayout>
